{
  "name": "thi-linux-macos-setup",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "upgradePackages": false
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y shellcheck && npm install",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Site preview",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "timonwong.shellcheck",
        "DavidAnson.vscode-markdownlint"
      ]
    }
  }
}
